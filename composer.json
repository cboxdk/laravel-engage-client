{
    "name": "cboxdk/laravel-engage-client",
    "description": "Cbox Engage client for Laravel: product events in, transactional messages out, and an `engage` mail driver with a circuit breaker and a fallback mailer.",
    "keywords": [
        "cbox",
        "engage",
        "laravel",
        "mail",
        "transactional",
        "product-events",
        "circuit-breaker"
    ],
    "homepage": "https://github.com/cboxdk/laravel-engage-client",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/cboxdk/laravel-engage-client/issues",
        "source": "https://github.com/cboxdk/laravel-engage-client"
    },
    "authors": [
        {
            "name": "Sylvester Damgaard",
            "email": "sn@cbox.dk",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/bus": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/mail": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "symfony/mailer": "^7.2 || ^8.0",
        "symfony/mime": "^7.2 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Cbox\\Engage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cbox\\Engage\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cbox\\Engage\\EngageServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint --test",
        "fix": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "test": "vendor/bin/pest",
        "license-check": "@php bin/check-licenses.php",
        "sbom": "@php bin/generate-sbom.php",
        "sbom-check": [
            "@sbom",
            "git diff --exit-code sbom.json"
        ],
        "qa": [
            "@lint",
            "@analyse",
            "@test",
            "@license-check",
            "@composer audit --no-dev",
            "@sbom-check"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
